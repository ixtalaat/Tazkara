{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_PRODUCTION_DB_SERVER;Database=TazkaraDb;User Id=YOUR_USER;Password=YOUR_PASSWORD;Trusted_Connection=False;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "JwtSettings": {
    "Key": "YOUR_PRODUCTION_SECRET_KEY_AT_LEAST_32_BYTES_LONG",
    "Issuer": "TazkaraAPI",
    "Audience": "TazkaraClients",
    "DurationInMinutes": 60
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "https://tazkara.com",
      "https://www.tazkara.com"
    ]
  }
}
